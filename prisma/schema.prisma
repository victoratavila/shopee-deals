// Schema do banco - PostgreSQL
// Rodar: npm run prisma:migrate (dev) ou npm run prisma:deploy (produção)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// PRODUCTS
// ---------------------------------------------------------------------------
model Product {
  id                String   @id @default(cuid())
  shopeeItemId      String   @unique // ID do produto na Shopee
  shopId            String? // ID da loja na Shopee, quando disponível
  name              String
  url               String
  imageUrl          String?
  category          String?

  currentPrice      Decimal  @db.Decimal(12, 2)
  previousPrice     Decimal? @db.Decimal(12, 2)
  discountPercent   Decimal? @db.Decimal(5, 2)

  rating            Decimal? @db.Decimal(3, 2)
  ratingCount       Int?
  salesCount        Int?
  commissionPercent Decimal? @db.Decimal(5, 2)

  affiliateLink     String?

  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  priceHistory      PriceHistory[]
  publishedDeals    PublishedDeal[]

  @@index([category])
  @@index([lastSeenAt])
  @@index([currentPrice])
}

// ---------------------------------------------------------------------------
// PRICE HISTORY
// ---------------------------------------------------------------------------
model PriceHistory {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  price      Decimal  @db.Decimal(12, 2)
  recordedAt DateTime @default(now())

  @@index([productId, recordedAt])
}

// ---------------------------------------------------------------------------
// PUBLISHED DEALS
// ---------------------------------------------------------------------------
enum PublishChannel {
  DRY_RUN
  TEST
  TELEGRAM
  WHATSAPP
}

model PublishedDeal {
  id               String         @id @default(cuid())
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  priceAtPublish   Decimal        @db.Decimal(12, 2)
  dealScore        Decimal        @db.Decimal(5, 2)
  channel          PublishChannel
  externalRef      String? // ID da mensagem publicada no canal externo, quando existir
  runId            String?
  run              Run?           @relation(fields: [runId], references: [id])

  // Preenchido quando a oferta foi originalmente rejeitada pelo sistema e um
  // administrador decidiu aprová-la manualmente pelo painel (seção 14).
  approvedManually     Boolean        @default(false)
  approvedBy           String?
  searchCategoryId     String?
  searchCategoryName   String?
  // Referência solta (sem FK) à RejectedOffer de origem, usada só para
  // permitir "Desfazer aprovação" no painel. Não é uma relação Prisma de
  // verdade porque a ligação é opcional nos dois sentidos.
  sourceRejectedOfferId String?

  publishedAt      DateTime       @default(now())

  @@index([productId, publishedAt])
  @@unique([productId, channel, publishedAt])
}

// ---------------------------------------------------------------------------
// RUNS (execuções do scheduler / execução manual)
// ---------------------------------------------------------------------------
enum RunStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum RunMode {
  TEST
  DRY_RUN
  PRODUCTION
}

model Run {
  id                String    @id @default(cuid())
  mode              RunMode
  status            RunStatus @default(RUNNING)

  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  durationMs        Int?

  productsFound     Int       @default(0)
  productsFiltered  Int       @default(0)
  dealsSelected     Int       @default(0)
  dealsPublished    Int       @default(0)
  errorsCount       Int       @default(0)

  triggeredBy       String? // "scheduler" | "manual" | admin user id

  publishedDeals    PublishedDeal[]
  rejections        RejectedOffer[]
  errorLogs         ErrorLog[]

  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// SCHEDULER LOCK (linha única - garante que só existe um Run RUNNING por vez)
// ---------------------------------------------------------------------------
// Sem isso, a checagem "já existe execução em andamento?" + criação do Run
// não era atômica: duas execuções quase simultâneas (scheduler + clique
// manual, por exemplo) podiam passar pela checagem ao mesmo tempo e criar
// dois Runs concorrentes - o que abriria brecha para a mesma oferta ser
// aprovada/publicada duas vezes. Ver PrismaRunRepository.create().
model SchedulerLock {
  id       Int       @id @default(1)
  locked   Boolean   @default(false)
  lockedAt DateTime?
  runId    String?
}

// ---------------------------------------------------------------------------
// REJECTED OFFERS (motivo de rejeição, por execução)
// ---------------------------------------------------------------------------
enum RejectionReason {
  DISCOUNT_BELOW_MINIMUM
  RATING_BELOW_MINIMUM
  REVIEWS_BELOW_MINIMUM
  SALES_BELOW_MINIMUM
  COMMISSION_BELOW_MINIMUM
  PRICE_OUT_OF_RANGE
  CATEGORY_BLOCKED
  CATEGORY_NOT_ALLOWED
  RECENTLY_PUBLISHED
  SUSPICIOUS_PRICE
  DUPLICATE
  INVALID_DATA
  DAILY_LIMIT_REACHED
  ROUND_LIMIT_REACHED
  // Oferta que tinha sido aprovada (automaticamente ou manualmente) e um
  // administrador decidiu rejeitar depois, pelo painel - o inverso da
  // aprovação manual.
  MANUALLY_REJECTED
}

model RejectedOffer {
  id                 String          @id @default(cuid())
  // Opcional (igual a PublishedDeal.runId) - uma rejeição manual de uma
  // oferta que já estava aprovada não nasce de uma execução do pipeline,
  // então não tem um Run associado.
  runId              String?
  run                Run?            @relation(fields: [runId], references: [id], onDelete: Cascade)

  shopeeItemId       String
  productName        String?
  reason             RejectionReason
  details            String?

  // Snapshot em JSON da oferta no momento da rejeição (preço, desconto,
  // avaliação, link, etc.) - é o que permite "Aprovar manualmente" depois,
  // sem precisar buscar o produto de novo na Shopee (seção 14/33).
  offerSnapshot      String?

  // Preenchido quando um administrador aprova manualmente essa oferta
  // pelo painel, revertendo a decisão automática do sistema.
  manuallyApprovedAt DateTime?
  manuallyApprovedBy String?

  createdAt          DateTime        @default(now())

  @@index([runId])
  @@index([reason])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// SETTINGS (configurações operacionais - key/value tipado)
// ---------------------------------------------------------------------------
model Setting {
  key       String   @id
  value     String // armazenado como JSON string, parseado pela camada de config
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ---------------------------------------------------------------------------
// ERROR LOGS
// ---------------------------------------------------------------------------
model ErrorLog {
  id        String   @id @default(cuid())
  runId     String?
  run       Run?     @relation(fields: [runId], references: [id])

  scope     String // ex: "shopee_client", "scheduler", "publisher"
  message   String
  stack     String?
  context   String? // JSON string com contexto adicional (sem dados sensíveis)

  createdAt DateTime @default(now())

  @@index([scope, createdAt])
}

// ---------------------------------------------------------------------------
// ADMIN USERS
// ---------------------------------------------------------------------------
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?
}
