# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA commite o arquivo ".env" no Git.

# --- Banco de dados ---
DATABASE_URL="postgresql://usuario:senha@localhost:5432/shopee_deals?schema=public"

# --- Modo de execução: TEST | DRY_RUN | PRODUCTION ---
RUN_MODE="TEST"

# --- Shopee Affiliate Open API (deixe em branco enquanto não tiver acesso) ---
# Onde obter: painel de afiliado Shopee -> seção "Open API"
SHOPEE_APP_ID=""
SHOPEE_APP_SECRET=""
SHOPEE_AFFILIATE_ID=""
# Opcional - só mude se sua conta de afiliado não for do Brasil.
SHOPEE_API_ENDPOINT=""

# --- Painel administrativo ---
ADMIN_SESSION_SECRET="troque-por-um-valor-aleatorio-longo"
PORT="3000"

# --- Cron externo (opcional - só necessário em hospedagem gratuita que ---
# --- "dorme" quando ociosa, ex: Render free tier). Ver DEPLOY.md.       ---
CRON_SECRET=""

# --- Ambiente ---
NODE_ENV="development"
